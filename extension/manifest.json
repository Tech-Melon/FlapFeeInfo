{
  "manifest_version": 3,
  "name": "技术瓜FlapFeeInfo",
  "version": "0.2.8",
  "description": "Show Flap tax allocation + quote pool (e.g. 🪙BNB|💎90%) on GMGN, Debot and Gungnir cards.",
  "icons": {
    "16": "icons/flap-16.png",
    "32": "icons/flap-32.png",
    "48": "icons/flap-48.png",
    "128": "icons/flap-128.png"
  },
  "action": {
    "default_title": "技术瓜FlapFeeInfo",
    "default_icon": {
      "16": "icons/flap-16.png",
      "32": "icons/flap-32.png",
      "48": "icons/flap-48.png",
      "128": "icons/flap-128.png"
    }
  },
  "host_permissions": ["https://flap-fee-info.tech-melon.workers.dev/*"],
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://debot.ai/*",
        "https://*.debot.ai/*",
        "https://gungnir.bot/*",
        "https://*.gungnir.bot/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
