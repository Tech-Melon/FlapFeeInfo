{
  "manifest_version": 3,
  "name": "技术瓜FlapFeeInfo",
  "version": "0.8.250",
  "description": "FlapFeeInfo 0.8.250: shared fee-core (platform registry + tested pure logic); keep 100% tax-vault option; Long.xyz ready.",
  "icons": {
    "16": "icons/flap-16.png",
    "32": "icons/flap-32.png",
    "48": "icons/flap-48.png",
    "128": "icons/flap-128.png"
  },
  "action": {
    "default_title": "FlapFeeInfo · Badge settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/flap-16.png",
      "32": "icons/flap-32.png",
      "48": "icons/flap-48.png",
      "128": "icons/flap-128.png"
    }
  },
  "host_permissions": [
    "https://taxinfo.tech-melon.top/*",
    "https://flap-fee-info.tech-melon.workers.dev/*"
  ],
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://debot.ai/*",
        "https://*.debot.ai/*",
        "https://gungnir.bot/*",
        "https://*.gungnir.bot/*"
      ],
      "js": ["tax-recv-bootstrap.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://debot.ai/*",
        "https://*.debot.ai/*",
        "https://gungnir.bot/*",
        "https://*.gungnir.bot/*"
      ],
      "js": ["fee-core.js", "page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://debot.ai/*",
        "https://*.debot.ai/*",
        "https://gungnir.bot/*",
        "https://*.gungnir.bot/*"
      ],
      "js": ["fee-core.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fee-core.js", "page-hook.js"],
      "matches": [
        "https://gmgn.ai/*",
        "https://debot.ai/*",
        "https://*.debot.ai/*",
        "https://gungnir.bot/*",
        "https://*.gungnir.bot/*"
      ]
    }
  ]
}
